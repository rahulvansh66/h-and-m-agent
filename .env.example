# Copy to .env and fill in. Names only; never commit real values.

# Neon Postgres (order management agent, DB tests)
NEON_POSTGRES_CONNECTION_STRING=
NEON_POSTGRES_TEST_CONNECTION_STRING=

# Groq
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# API: shared secret clients send in the X-API-Key header (python -m hm_agent.api)
API_KEY=

# Qdrant (vector store for RAG)
QDRANT_ENDPOINT=
QDRANT_API_KEY=

# Neon S3-compatible object storage (source documents for ingestion)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# Optional per-deployment overrides of the A2A agent URLs the supervisor calls
# (default: http://<a2a.host>:<port> from config/base.yaml)
# ORDER_MANAGEMENT_AGENT_URL=http://order-management:8001
# CUSTOMER_SUPPORT_AGENT_URL=http://customer-support:8002

# Auth0 tenant (domain or URL, e.g. your-tenant.us.auth0.com). Its URL is the expected token issuer when AUTH_ENABLED is on.
AUTH0_TENANT=

# Optional switches for deployed environments (defaults in config/base.yaml: both off locally).
# AUTH_ENABLED=true     # verify the end-user OIDC token (audience/claim are in config/, issuer from AUTH0_TENANT)
# SIGV4_ENABLED=true    # sign supervisor-to-agent A2A calls with IAM credentials (region: aws.region in config/)
# PUSH_RECEIVER_ENABLED=false  # stream-only: no webhook receiver on the supervisor (default: true)

# Where an agent service listens (default: a2a.host and its own port). AgentCore Runtime needs 0.0.0.0:9000.
# A2A_BIND_HOST=0.0.0.0
# A2A_BIND_PORT=9000
# Local port of the AgentCore entrypoint (default runtime.port, 8080).
# RUNTIME_PORT=8090

# Optional: append every A2A request/response body (JSON lines) to this file. Debug only, contains customer text.
# A2A_WIRE_LOG=

# AWS CloudWatch Logs: named AWS CLI profile (separate from the Neon S3 keys above).
# Only used when logging.cloudwatch.enabled is true in config/.
CLOUDWATCH_AWS_PROFILE=
